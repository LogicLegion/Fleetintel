                 alt="Fleet Intelligence Dashboard preview">
        </div>
    </section>

    <!-- FEATURES -->
    <section class="container features" id="features">
        <h2>Everything you need to optimize your fleet</h2>
        <p class="features-sub">One dashboard. All your assets. Real-time insights.</p>
        <div class="feature-grid">
            <div class="feature-card">
                <div class="feature-icon">📊</div>
                <h3>12 Key Metrics</h3>
                <p>Volume, reject rate, uptime, daily loss, service days, and more — all in one view.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🗺️</div>
                <h3>Live Map</h3>
                <p>See all your assets on a map. Color-coded by status — critical, warning, good, offline.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🔍</div>
                <h3>Filters & Search</h3>
                <p>Filter by region, status, or search for any asset. Find what you need in seconds.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">💰</div>
                <h3>Daily Loss Calculator</h3>
                <p>See exactly how much each machine is losing from rejects and downtime.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">📞</div>
                <h3>One-Click Call</h3>
                <p>Call your technician directly from the dashboard. No more searching for phone numbers.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">📸</div>
                <h3>Export Reports</h3>
                <p>Download screenshots or full reports to share with your team or management.</p>
            </div>
        </div>
    </section>

    <!-- PRICING -->
    <section class="container pricing" id="pricing">
        <h2>Simple, transparent pricing</h2>
        <p style="color:#475569; margin-top:8px;">No hidden fees. Cancel anytime.</p>
        <div class="pricing-card">
            <div class="pricing-price">$199 <span>/ month</span></div>
            <p style="color:#475569; margin: 8px 0 16px;">Per location · Unlimited users</p>
            <ul>
                <li>Unlimited assets</li>
                <li>Live dashboard with maps</li>
                <li>Filters, search, and sorting</li>
                <li>Export reports and screenshots</li>
                <li>14-day free trial</li>
                <li>No contract — cancel anytime</li>
            </ul>
            <a href="#cta" class="btn-primary">Start Free Trial</a>
        </div>
    </section>

    <!-- CTA -->
    <section class="container cta-section" id="cta">
        <h2>Ready to stop losing money?</h2>
        <p>Upload your fleet data and see exactly which machines need attention. Start your free trial today.</p>
        <a href="#" class="btn-primary">Start Free Trial</a>
        <p style="margin-top:20px; color:#94a3b8; font-size:0.85rem;">No credit card needed · 14-day free trial</p>
    </section>
</main>

<footer class="container footer">
    <p>&copy; 2026 FleetIntel. Built with ❤️ in Canada.  <a href="mailto:your-email@example.com">Contact</a></p>
</footer>

